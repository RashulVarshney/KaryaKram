{
  "name": "@karyakram/worker-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Worker run loop, reaper, and the deterministic replay engine's worker-side glue.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "worker": "dotenv -e ../../.env -- tsx src/bin/task-runner.ts",
    "reaper": "dotenv -e ../../.env -- tsx src/bin/run-reaper.ts",
    "demo": "dotenv -e ../../.env -- tsx src/bin/demo.ts",
    "demo:m3": "dotenv -e ../../.env -- tsx src/bin/demo-m3.ts",
    "demo:m4": "dotenv -e ../../.env -- tsx src/bin/demo-m4.ts"
  },
  "dependencies": {
    "@karyakram/core": "workspace:*",
    "@karyakram/db": "workspace:*",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "dotenv-cli": "^11.0.0"
  }
}
