# Copy this file to .env and adjust as needed. .env is gitignored.

# Postgres connection string used by packages/db, workers, and the reaper.
# Matches the credentials in docker/docker-compose.yml.
DATABASE_URL=postgres://karyakram:karyakram@localhost:5432/karyakram

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Identifies this worker process in logs and in tasks.leased_by.
# Defaults to `hostname-pid-random` at runtime if unset.
WORKER_ID=

# --- Durable LLM steps (see docs/DECISIONS.md) ---------------------------
# Which provider backs llm_call steps: mock | anthropic. Default: mock (no network, no key).
# Choosing anthropic WITHOUT a key is an error; it never falls back to mock.
LLM_PROVIDER=mock
# Only read when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Model used when a request says model: 'default'.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional JSON price table (USD per million tokens) used for estimated cost, e.g.
# {"claude-opus-5-5":{"inputPerMTokUsd":4,"outputPerMTokUsd":20}}
KARYAKRAM_LLM_PRICES=
# Mock provider knobs (tests/benchmarks): simulated latency and scripted failures, e.g.
# MOCK_LLM_FAILURES=[{"on":429,"failAttempts":2,"retryAfterMs":200}]
MOCK_LLM_LATENCY_MS=
MOCK_LLM_FAILURES=
