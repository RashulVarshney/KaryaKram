# Copy this file to .env and adjust as needed. .env is gitignored.

# Postgres connection string used by packages/db, workers, and the reaper.
# Matches the credentials in docker/docker-compose.yml.
DATABASE_URL=postgres://karyakram:karyakram@localhost:5432/karyakram

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Identifies this worker process in logs and in tasks.leased_by.
# Defaults to `hostname-pid-random` at runtime if unset.
WORKER_ID=
